# Splitwise MCP server configuration.
# Copy to .env and fill in. NEVER commit .env.
#
# Create the key at https://secure.splitwise.com/apps → register an app (any name) →
# on the app's page click "API key". It is a personal access token for your WHOLE
# account (read + write) — keep it like a password; regenerate on the same page to rotate.

# Personal API key, sent as `Authorization: Bearer <key>` on every request. Required.
SPLITWISE_API_KEY=

# Kill-switch. Leave unset for a read-only server. Set to 1 to allow creating, updating,
# deleting and restoring expenses, groups, friends and comments, and editing your profile
# (name/locale/currency only — email and password can never be changed through the MCP).
# SPLITWISE_ALLOW_WRITES=1

# REST base URL. Only override for proxies/testing.
# SPLITWISE_API_URL=https://secure.splitwise.com/api/v3.0

# Per-request timeout in seconds.
# SPLITWISE_REQUEST_TIMEOUT_SECONDS=30

# --- Remote transport (only read by `amazing-splitwise-mcp-http`) ---------------------
# Shared secret the client must send as `Authorization: Bearer <value>`. At least 32
# characters; generate one with `openssl rand -hex 32`. The server refuses to start without it.
# SPLITWISE_MCP_BEARER=

# Bind address/port/path. Loopback by default — put TLS (a reverse proxy, Tailscale Funnel)
# in front. Binding beyond loopback requires SPLITWISE_MCP_ALLOWED_HOSTS.
# SPLITWISE_MCP_HOST=127.0.0.1
# SPLITWISE_MCP_PORT=8765
# SPLITWISE_MCP_PATH=/mcp

# Comma-separated Host header values to accept (DNS-rebinding protection), e.g.
# the public hostname your proxy forwards. Empty = protection off (loopback only).
# SPLITWISE_MCP_ALLOWED_HOSTS=

# With host pinning on, a request carrying an `Origin` that is not one of the allowed
# hosts gets 403. List extra origins a cloud client sends (e.g. https://grok.com).
# SPLITWISE_MCP_ALLOWED_ORIGINS=

# Stateless streamable-http (no server-side sessions) — the mode cloud clients expect.
# SPLITWISE_MCP_STATELESS=1

# Test-suite switch: set to 1 to run the mutating `live_write` tests (they create and
# delete a throwaway group + expense in YOUR account).
# SPLITWISE_TEST_ALLOW_WRITES=
